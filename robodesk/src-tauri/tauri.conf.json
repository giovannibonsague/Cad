{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoboDesk",
  "version": "0.1.0",
  "identifier": "com.robodesk.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RoboDesk",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RoboDesk",
    "category": "DeveloperTool",
    "shortDescription": "Robotics engineering workspace",
    "longDescription": "Offline workspace for robot projects: parts inventory, bills of materials, CAD file references, wiring diagrams and build planning.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
