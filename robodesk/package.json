{
  "name": "robodesk",
  "version": "0.1.0",
  "private": true,
  "description": "RoboDesk: robotics engineering workspace (Tauri desktop app)",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
